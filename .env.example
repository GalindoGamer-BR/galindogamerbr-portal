VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_MULTICHAT_COMMAND_URL=

# Vinculacao de contas (desligadas por padrao; a leitura do chat continua):
# TIKTOK_LINKING_ENABLED=false    # entrar com TikTok e sessao de envio por QR
# YOUTUBE_LINKING_ENABLED=false   # vincular conta do YouTube (login Google) e enviar mensagens
# GOOGLE_LOGIN_ENABLED=false      # botao "Entrar com Google" (exige o provedor Google no Supabase)
# GOOGLE_LOGIN_YOUTUBE_ENABLED=false  # o login com Google pede tambem o escopo do YouTube e vincula o chat sozinho (so apos verificar o app)
# GOOGLE_LOGIN_CLIENT_ID= / GOOGLE_LOGIN_CLIENT_SECRET=   # so no Supabase local; no hospedado vao no painel do Supabase

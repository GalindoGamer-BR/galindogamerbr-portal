server {
  listen 8080;
  access_log off;
  client_max_body_size 1m;
  resolver 127.0.0.11 valid=10s;
  if ($http_x_preview_bridge != "${PREVIEW_BRIDGE_KEY}") { return 404; }
  proxy_set_header Host preview.galindogamerbr.com.br;
  proxy_set_header X-Forwarded-Proto https;
  proxy_hide_header Access-Control-Allow-Origin;
  add_header Cache-Control "no-store" always;
  add_header X-Robots-Tag "noindex, nofollow" always;
  location ~ ^/(admin|api/admin|internal)(/|$) { return 404; }
  location ~ ^/(oauth/tiktok/(login|authorize|callback|exchange|start)|api/(member|account(?:/email(?:/confirm)?)?|accounts(?:/(?:twitch|youtube|kick))?|chat/messages|tiktok/(?:connection|live(?:/confirm)?)))$ {
    set $backend http://command:3000;
    proxy_pass $backend;
  }
  location ~ ^/auth/v1/(token|user|logout|authorize|callback)$ {
    set $auth_backend http://auth:9999;
    rewrite ^/auth/v1/(.*)$ /$1 break;
    proxy_pass $auth_backend;
  }
  location = /realtime/v1/websocket {
    set $realtime_backend http://supabase:8000;
    proxy_pass $realtime_backend;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
  }
  location ~ ^/(auth|rest|realtime)/ { return 404; }
  location / {
    set $portal http://portal:8788;
    proxy_pass $portal;
  }
}

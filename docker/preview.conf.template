server {
  listen 8080;
  access_log off;
  client_max_body_size 1m;
  resolver 127.0.0.11 valid=10s;
  # Only the preview's Pages proxy (which sends X-Origin-Auth) and Supabase Auth callers get through.
  set $has_bridge 0;
  if ($http_x_origin_auth = "${PREVIEW_BRIDGE_KEY}") { set $has_bridge 1; }
  proxy_set_header Host preview.galindogamerbr.com.br;
  proxy_set_header X-Forwarded-Proto https;
  proxy_hide_header Access-Control-Allow-Origin;
  add_header Cache-Control "no-store" always;
  add_header X-Robots-Tag "noindex, nofollow" always;
  location ~ ^/(admin|api/admin|api/auth|webhooks|internal)(/|$) { return 404; }
  location ~ ^/(oauth/tiktok/(login|authorize|callback|exchange|start)|api/(member|account(?:/email(?:/confirm)?)?|accounts(?:/(?:twitch|youtube|kick))?|chat/messages|tiktok/(?:connection|live(?:/confirm)?)|live|flagship|schedule|farm-status|farm/welcome-video|multichat-emotes|community-stats))$ {
    if ($has_bridge = 0) { return 404; }
    set $gateway http://gateway:80;
    proxy_pass $gateway;
  }
  location ~ ^/auth/v1/(token|user|logout|authorize|callback)$ {
    set $auth_backend http://auth:9999;
    rewrite ^/auth/v1/(.*)$ /$1 break;
    proxy_pass $auth_backend;
  }
  location = /realtime/v1/websocket {
    set $realtime_backend http://supabase:8000;
    proxy_pass $realtime_backend;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
  }
  location / { return 404; }
}
